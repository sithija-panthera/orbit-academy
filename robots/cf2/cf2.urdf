<?xml version="1.0"?>
<!-- Bitcraze Crazyflie 2.x — mesh from gym-pybullet-drones (MIT License,
     University of Toronto DSL). Real airframe: 92 mm motor-to-motor, 27 g.
     Frames per REP-103 (z-up). -->
<robot name="cf2">
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/cf2.dae"/></geometry>
    </visual>
    <inertial>
      <mass value="0.027"/>
      <inertia ixx="1.4e-5" iyy="1.4e-5" izz="2.17e-5" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
</robot>
